						<ISP2 range="{CAS, MOSI1, SPI_CK2, SPI_CS1}">CAS</ISP2>
					</LCM>
					<SCA0>
						<ISP1 range="{CKR, CKW, SCR_AGET, SCW_AGET}">CKW</ISP1>
						<ISP2 range="{RCK, SCR, SCW, WCK}">SCR</ISP2>
					</SCA0>
					<SCA1>
